# ── Invoice Ninja + PayHere — Dokploy Environment tab ────────────────────────
# Paste ALL of these into the Dokploy "Environment" tab. Dokploy writes them to
# a .env next to docker-compose.yml, which the app loads via env_file.
#
# Fill in: APP_URL, DB_PASSWORD, DB_ROOT_PASSWORD. APP_KEY below is already
# generated for you (regenerate with: echo "base64:$(openssl rand -base64 32)").

APP_NAME=InvoiceNinja
APP_ENV=production
APP_KEY=base64:FWfbSGxOUu8zyeYqJ09LYw5yJbnomC+QRObvDbQO/D8=
APP_DEBUG=false
APP_URL=https://your-domain.example.com

# Behind Dokploy's Traefik proxy — required so HTTPS links (incl. the PayHere
# notify_url) are generated correctly.
REQUIRE_HTTPS=true
TRUSTED_PROXIES=*
IS_DOCKER=true

# ── Database (the compose "db" service; host is the service name "db") ────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=CHANGE_ME_STRONG
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

# ── Cache / queue / session ──────────────────────────────────────────────────
# QUEUE_CONNECTION=sync runs the PayHere IPN job inline when the callback hits,
# so no separate worker container is needed.
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync
REDIS_HOST=redis
REDIS_PORT=6379

# ── Mail (set to your SMTP for real reminders/receipts) ──────────────────────
MAIL_MAILER=log
