# ── Invoice Ninja + PayHere — Dokploy Environment tab ────────────────────────
# Paste ONLY these into the Dokploy "Environment" tab. docker-compose.yml reads
# them via ${...} interpolation and injects the full config into the container.
# The infra values (DB_HOST=db, REDIS_HOST=redis, drivers, etc.) are already
# hardcoded in the compose file — you do NOT set them here.
#
# Generate APP_KEY with:  echo "base64:$(openssl rand -base64 32)"

APP_KEY=base64:CHANGE_ME
APP_URL=https://your-domain.example.com

DB_PASSWORD=CHANGE_ME_STRONG
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

# Optional overrides (compose defaults shown):
# APP_NAME=InvoiceNinja
# DB_DATABASE=ninja
# DB_USERNAME=ninja
